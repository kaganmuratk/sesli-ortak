# Bu dosyayi .env olarak kopyala ve kendi key'ini yapistir:
#   cp .env.example .env
# .env dosyasi git'e eklenmeyecek (bkz. .gitignore), sadece bu makinede kalir.

ELEVENLABS_API_KEY=
# ElevenLabs > Profile / API Keys sayfandan alabilirsin.

ELEVENLABS_VOICE_ID=
# Bos birakirsan varsayilan bir ses secilir (kurulumda birlikte ayarlariz).

ORTAK_PENCERE_ANAHTARI=
# ZORUNLU. Claude Code'u calistirdigin terminal penceresinin basligindan
# gecen, benzersiz bir kelime (orn. proje klasor adin). Tetikleyici bu
# kelimeyi gorunce o pencereye odaklanir. KDE Plasma'da terminal basligi
# genelde calisan komut + klasor adini icerir.

ORTAK_TERMINAL_SINIFI=org.kde.konsole
# Terminal uygulamanin KWin resourceClass'i. Konsole disinda bir terminal
# kullaniyorsan degistir (orn. Alacritty icin "Alacritty").
